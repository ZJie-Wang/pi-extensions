{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "workspaces": [
    "extensions/*"
  ],
  "scripts": {
    "typecheck": "tsc",
    "pack:check": "npm pack --dry-run --workspaces --json > /dev/null",
    "check": "npm run typecheck && npm run pack:check"
  },
  "pi": {
    "extensions": [
      "./extensions/ask-user/index.ts",
      "./extensions/deepseek-web/index.ts",
      "./extensions/lazygit/index.ts",
      "./extensions/subagents/src/index.ts",
      "./extensions/todo/index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
